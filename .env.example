ADMIN_PASSWORD=replace-with-a-unique-local-password
SERPER_API_KEY=replace-with-your-Serper-API-key
GEMINI_API_KEY=replace-with-your-Gemini-API-key
# Set after signing the Android app to enable full-screen Trusted Web Activity:
# ANDROID_APP_ID=com.zenvora.app
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:DD:...:REPLACE_WITH_64_HEX_DIGITS
# For public hosting, bind behind an HTTPS reverse proxy and enable secure cookies:
# HOST=0.0.0.0
# SECURE_COOKIES=true
# TRUST_PROXY=true